# ---------------------------------------------------------------
# 이 파일을 복사해서 .env 를 만드세요:  cp .env.example .env
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.
# (주의) Node 내장 --env-file 은 ${변수} 치환을 지원하지 않습니다.
#        값은 항상 "완성된 문자열"로 적어주세요.
# ---------------------------------------------------------------

# --- Solana (devnet) ---
# https://helius.dev 가입 후 API 키 발급
HELIUS_API_KEY=

# 00-create-wallet.ts 가 출력해준 값을 붙여넣으세요 (base58 문자열)
SOLANA_SECRET_KEY=
# 02-send.ts 에서 보낼 대상 주소 (비워두면 자기 자신에게 보냄)
SOLANA_RECIPIENT=

# --- Ethereum (Sepolia) ---
# https://tatum.io 가입 후 API 키 발급
TATUM_API_KEY=

# 00-create-wallet.ts 가 출력해준 값을 붙여넣으세요 (0x + 64자리 hex)
ETH_PRIVATE_KEY=
# 02-send.ts 에서 보낼 대상 주소 (비워두면 자기 자신에게 보냄)
ETH_RECIPIENT=
